{
  "expo": {
    "name": "Day2Day News",
    "slug": "day2day-news",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "entryPoint": "index.js",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f9f9f9"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.d2dnews",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.d2dnews"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "enableBackgroundPlayback": true
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "supabaseUrl": "https://yahltrcxuvcgwdtsvmwk.supabase.co",
      "supabaseAnonKey": "sb_publishable_h_TnmS8AogSHOCohx6E3PA_8skGUfwU"
    }
  }
}
